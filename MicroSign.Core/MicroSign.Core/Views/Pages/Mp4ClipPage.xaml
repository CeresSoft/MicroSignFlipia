<UserControl x:Class="MicroSign.Core.Views.Pages.Mp4ClipPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MicroSign.Core.Views.Pages"
             xmlns:vm="clr-namespace:MicroSign.Core.ViewModels.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid x:Name="RootGrid" Margin="5">
        <Grid.DataContext>
            <vm:Mp4ClipPageViewModel x:Name="ViewModel"/>
        </Grid.DataContext>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="{Binding VideoFilename}" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <Viewbox>
                <Canvas x:Name="Video" Width="{Binding VideoWidth}" Height="{Binding VideoHeight}">
                    <Canvas.Background>
                        <ImageBrush ImageSource="{Binding VideoImage}" Stretch="UniformToFill" />
                    </Canvas.Background>
                    <Border x:Name="ClipFrame" BorderBrush="Red" BorderThickness="1" Canvas.Left="{Binding ClipFrameX}" Canvas.Top="{Binding ClipFrameY}" Width="{Binding ClipFrameWidth}" Height="{Binding ClipFrameHeight}" Background="#01000000" MouseLeftButtonDown="ClipFrame_MouseLeftButtonDown"  MouseMove="ClipFrame_MouseMove"  MouseLeftButtonUp="ClipFrame_MouseLeftButtonUp"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <Grid Grid.Row="4">
            <Slider Value="{Binding SelectVideoPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="{Binding MaxDurationTicks}"/>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button x:Name="OkButton" Grid.Column="1" Content="OK" Click="OkButton_Click"/>

            <Button x:Name="CancelButton" Grid.Column="3" Content="キャンセル" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
